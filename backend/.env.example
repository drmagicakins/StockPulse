# StockPulse backend environment (DEV defaults).
# `make backend-install` / scripts/backend-env.sh creates backend/.env from this file and fills the
# secret placeholders from the repository root .env. NEVER commit backend/.env.

APP_NAME=StockPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# saas | private
DEPLOYMENT_MODE=saas
# Private mode only: the single business served by this installation (must be > 0 when DEPLOYMENT_MODE=private)
STOCKPULSE_PRIVATE_BUSINESS_ID=0
API_RATE_LIMIT_PER_MINUTE=120

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Runtime database connection: application role through PgBouncer (transaction pooling)
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=stockpulse
DB_USERNAME=stockpulse_app
DB_PASSWORD=__DB_APP_PASSWORD__

# Migration connection: schema owner, direct to PostgreSQL (never used at runtime)
DB_OWNER_HOST=postgres
DB_OWNER_PORT=5432
DB_OWNER_DATABASE=stockpulse
DB_OWNER_USERNAME=stockpulse_owner
DB_OWNER_PASSWORD=__DB_OWNER_PASSWORD__

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REDIS_PASSWORD__
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# S3-compatible storage (RustFS in development)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=__S3_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__S3_SECRET_KEY__
AWS_DEFAULT_REGION=__S3_REGION__
AWS_BUCKET=__S3_BUCKET__
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail (Mailpit in development)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@stockpulse.local"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
