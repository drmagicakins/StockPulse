# StockPulse local development environment (WP 1B).
# DEV-ONLY values. Copy to .env with `make env`, then change anything you like.
# NEVER commit .env. Avoid quotes, spaces, $ and # in values.

# ---- PostgreSQL ----
# Set to 19 only after the official postgres:19 image is confirmed; changing the major needs a fresh volume (make reset-db).
POSTGRES_VERSION=18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-superuser-change-me
POSTGRES_DB=stockpulse
# Role that owns the schema and runs migrations (stockpulse_owner)
DB_OWNER_PASSWORD=dev-db-owner-change-me
# Runtime role used by the application (stockpulse_app): no superuser, no BYPASSRLS, owns nothing
DB_APP_PASSWORD=dev-db-app-change-me

# ---- Redis ----
REDIS_PASSWORD=dev-redis-change-me

# ---- S3-compatible storage (dev only: RustFS) ----
S3_ACCESS_KEY=stockpulsedev
S3_SECRET_KEY=dev-s3-secret-change-me
S3_BUCKET=stockpulse-dev
S3_REGION=us-east-1

# ---- Host ports (all bound to 127.0.0.1) ----
NGINX_PORT=8080
POSTGRES_PORT=5433
PGBOUNCER_PORT=6433
REDIS_PORT=6380
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
VITE_PORT=5173

# ---- Container user (match your Ubuntu user: run `id -u` and `id -g`) ----
HOST_UID=1000
HOST_GID=1000

# ---- Images that are not version-pinned yet (pinned by digest in WP 1I) ----
RUSTFS_IMAGE=rustfs/rustfs:latest
MAILPIT_IMAGE=axllent/mailpit:latest
AWSCLI_IMAGE=amazon/aws-cli:latest
